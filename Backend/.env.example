# =====================================================================================================
#  Masroofy backend: environment settings
# =====================================================================================================
#  This file is a TEMPLATE. It is committed to git and contains no secrets.
#  Your real settings go in a file named ".env" in this same Backend/ folder. ".env" is git-ignored,
#  so it never gets pushed and every team member makes their own.
#
#  SETUP FOR A NEW TEAM MEMBER (about 10 minutes)
#  -----------------------------------------------
#  Prerequisites: Docker Desktop installed and running.
#
#  1. Create your .env from this template (run inside the Backend/ folder):
#         cp .env.example .env            (Windows PowerShell: Copy-Item .env.example .env)
#     Files starting with "." are hidden in Finder: press Cmd + Shift + . to show them.
#
#  2. Firebase. You need two things from the team's Firebase project "Masroofy" (masroofy-1a1e3):
#     a) Ask the project owner to add you: Firebase console > Project settings > Users and permissions >
#        Add member, with the "Editor" role. Accept the invitation email.
#     b) Service-account key (a JSON file, a SECRET):
#        https://console.firebase.google.com/project/masroofy-1a1e3/settings/serviceaccounts/adminsdk
#        > "Generate new private key" > "Generate key". Each person can generate their own key.
#        Move the downloaded file to   Backend/secrets/firebase-service-account.json
#        (create the "secrets" folder if needed; it is git-ignored). Never commit it or paste it in chat.
#     c) Web API key: https://console.firebase.google.com/project/masroofy-1a1e3/settings/general
#        > "Web API key" (starts with "AIza"). Paste it into FIREBASE_WEB_API_KEY below.
#     Want an isolated sandbox instead? Create your own Firebase project, turn on Authentication >
#     Sign-in method > Email/Password, add a Web app, and use that project's key file and Web API key.
#
#  3. Fill in the values marked  <-- REQUIRED  below:
#        DB_PASSWORD       any password you like (it only protects your local Docker database)
#        AUTH_CODE_SECRET  a random string of 32+ characters. Generate one with:
#                              openssl rand -hex 32
#                          (no openssl? any 32+ random letters and digits work)
#
#  4. Email. Keep MAIL_PROVIDER=log for development: verification and reset codes are printed in the
#     backend log instead of being emailed. Read them with:
#         docker compose logs -f backend | grep "DEV EMAIL"
#     To send real emails, see the "Email" section below.
#
#  5. Start everything (inside Backend/):
#         docker compose up -d --build
#     Then open Swagger UI: http://localhost:8080/swagger-ui.html
#     Check it is healthy: http://localhost:8080/actuator/health  ->  {"status":"UP"}
#     Optional full check of every endpoint (needs MAIL_PROVIDER=log):  ./scripts/smoke-test.sh
#
#  GOOD TO KNOW
#  - Everyone on the shared Firebase project shares its users, but each person has their own local
#    database. If a teammate already signed up with an email, signing up with the same email on your
#    machine returns EMAIL_ALREADY_IN_USE. Use your own test addresses, e.g. yourname+test1@gmail.com.
#  - After changing .env, apply it with:  docker compose up -d
#  - The backend refuses to start and names the missing setting if something required is empty.
#    See why with:  docker compose logs backend
#  - "bind source path does not exist: .../secrets/firebase-service-account.json" means the key file
#    from step 2b is missing or has a different name.
#  - "required variable ... is missing a value" means that line in your .env is still empty.
# =====================================================================================================


# ---- Ports on your machine ------------------------------------------------------------------------
# Change them only if 8080 or 5432 is already used on your computer.
BACKEND_PORT=8080
DB_PORT=5432


# ---- PostgreSQL (runs in Docker; created automatically on first start) ----------------------------
DB_NAME=masroofy
DB_USERNAME=masroofy
# <-- REQUIRED: choose any password. If you change it later, also run "docker compose down -v"
#     (this deletes your local database) because the password is fixed when the database is created.
DB_PASSWORD=


# ---- Firebase Authentication (see step 2) ---------------------------------------------------------
# Where the service-account key file is on your machine. Keep the default unless you saved it elsewhere.
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json
# Optional: the project ID is read from the key file when this is empty.
FIREBASE_PROJECT_ID=masroofy-1a1e3
# <-- REQUIRED: the project's Web API key (starts with "AIza").
FIREBASE_WEB_API_KEY=


# ---- One-time codes (see step 3) ------------------------------------------------------------------
# <-- REQUIRED: random secret, at least 32 characters. Used to hash verification and reset codes.
AUTH_CODE_SECRET=


# ---- Email ----------------------------------------------------------------------------------------
# log  = print codes in the backend log (recommended for development; needs nothing else).
# smtp = send real emails. Then fill in MAIL_USERNAME and MAIL_PASSWORD below.
MAIL_PROVIDER=log
# For Gmail keep smtp.gmail.com and 587.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Only for MAIL_PROVIDER=smtp:
#   MAIL_USERNAME  the Gmail address the app sends FROM. Users receive codes at THEIR OWN email.
#   MAIL_PASSWORD  a Gmail App Password, NOT your normal Gmail password. Create one at
#                  https://myaccount.google.com/apppasswords (needs 2-Step Verification turned on).
#                  Spaces in it are ignored. Never commit it.
MAIL_USERNAME=
MAIL_PASSWORD=
# Leave empty to send as MAIL_USERNAME (Gmail only allows your own address or a verified alias).
MAIL_FROM=


# ---- Optional -------------------------------------------------------------------------------------
# Empty or "dev". "dev" forces MAIL_PROVIDER=log.
SPRING_PROFILES_ACTIVE=
# Comma-separated browser origins allowed to call the API. The Android app does not need this.
CORS_ALLOWED_ORIGINS=
# Set to false to hide Swagger UI (for example in production).
SWAGGER_ENABLED=true
