# Copy this file to .env and change what you need.
# Every setting has a safe default, so the project also runs with NO .env file at all.

# ---------------- Speech-to-text (ASR) ----------------
# auto | faster_whisper | openai_api | mock
# auto tries faster_whisper -> openai_api (only if OPENAI_API_KEY is set) -> mock
ASR_BACKEND=auto
# Whisper model size. "small" is a good CPU default. Use "medium" or "large-v3" on a GPU (Colab T4).
WHISPER_MODEL=small
# cpu | cuda | auto. Default cpu: works on every laptop without NVIDIA's CUDA libraries.
# Use cuda (or auto = GPU if one is visible) only on a machine with CUDA 12 + cuDNN, e.g. Colab T4.
WHISPER_DEVICE=cpu
# auto | ar | en. Default ar: Egyptian and code-switched speech is usually transcribed better with Arabic forced.
ASR_LANGUAGE=ar
# Text that "primes" Whisper to write Western digits and Latin brand names inside Arabic sentences.
ASR_INITIAL_PROMPT=دفعت 150 جنيه في Uber امبارح. صرفت 250 على groceries. اشتريت من Carrefour بـ 320 جنيه.
# Longest accepted recording in seconds.
ASR_MAX_DURATION_S=60
# Largest accepted upload in megabytes (REST API).
MAX_UPLOAD_MB=10
# Model used by the openai_api ASR backend.
OPENAI_ASR_MODEL=whisper-1

# ---------------- Extraction ----------------
# rules | llm | hybrid   (hybrid = rules first, LLM only for missing / low-confidence fields)
EXTRACTOR_MODE=hybrid
# Rule fields below this confidence are sent to the LLM in hybrid mode.
HYBRID_CONFIDENCE_THRESHOLD=0.6
# Fields below this confidence are listed in needs_review so the app highlights them.
REVIEW_CONFIDENCE_THRESHOLD=0.6

# ---------------- Optional LLM ----------------
# none | anthropic | openai_compatible
LLM_PROVIDER=none
# Model name. For anthropic the default is claude-haiku-5-5. For Ollama use e.g. qwen2.5:7b
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave empty for api.openai.com. For local Ollama use http://localhost:11434/v1 (any key string works).
OPENAI_BASE_URL=
# Seconds before an LLM call is abandoned (the rule result is kept).
LLM_TIMEOUT_S=15
# 1 = cache LLM answers on disk so repeated evaluation runs are free, 0 = off
LLM_CACHE=1
LLM_CACHE_DIR=.cache/llm

# ---------------- Storage and misc ----------------
# SQLite file for confirmed transactions.
DB_PATH=expenses.db
TIMEZONE=Africa/Cairo
DEFAULT_CURRENCY=EGP
# DEBUG | INFO | WARNING
LOG_LEVEL=WARNING
