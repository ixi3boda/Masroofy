# Copy to .env.local (git-ignored) and change what you need, then restart Expo with: npx expo start -c
# Every value is optional. With nothing set, the whole app runs on mock data (src/mocks).
# Rules: docs/frontend-api/00-instructions-for-claude.md section 3.

# Default data source for every service: mock | api
EXPO_PUBLIC_API_MODE=mock

# Per-service overrides (empty = use EXPO_PUBLIC_API_MODE): mock | api
EXPO_PUBLIC_AUTH_SOURCE=
# No dashboard API on the backend yet: "api" falls back to mock with a warning.
EXPO_PUBLIC_DASHBOARD_SOURCE=
# No SMS API on the backend yet: "api" falls back to mock with a warning.
EXPO_PUBLIC_SMS_SOURCE=
# No transactions API on the backend yet: "api" falls back to mock with a warning.
EXPO_PUBLIC_TRANSACTIONS_SOURCE=

# Backend base URL, used only by services on "api".
#   web / iOS simulator: http://localhost:8080/api/v1
#   Android emulator:    http://10.0.2.2:8080/api/v1
#   phone (Expo Go):     http://<your PC's Wi-Fi IP>:8080/api/v1
# Web also needs CORS_ALLOWED_ORIGINS=http://localhost:8081 in Backend/.env.
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Request timeout in milliseconds
EXPO_PUBLIC_API_TIMEOUT_MS=15000
